#!/bin/zsh

function os() {
  unameOut="$(uname -s)"
  case "${unameOut}" in
    Linux*)     machine=Linux;;
    Darwin*)    machine=Mac;;
    CYGWIN*)    machine=Cygwin;;
    MINGW*)     machine=MinGw;;
    MSYS_NT*)   machine=MSys;;
    *)          machine=Other;;
  esac
  echo ${machine}
}

function killport() {
  lsof -i TCP:$1 | grep LISTEN | awk '{print $2}' | xargs kill -9
}

function os_appearance() {
  os=$(os)
  if (test $os = "Mac"); then
    macos_appearance;
  elif (test $os = "Linux"); then
    linux_appearance;
  else
    echo "dark"
  fi
}

function linux_appearance() {
  if [[ "$(gsettings get org.cinnamon.theme name)" =~ "[Dd]ark" ]]; then
    echo "dark";
  else
    echo "light";
  fi
}

function macos_appearance() {
  if (test "$(defaults read -g AppleInterfaceStyle 2>&1)" = "Dark"); then
    echo "dark";
  else 
    echo "light";
  fi
}

# Simple MOV to GIF conversion
# Usage: ./mov2gif.sh input.mov [output.gif]
function mov2gif() {
  INPUT="${1:-./test.mov}"
  OUTPUT="${2:-${INPUT%.mov}.gif}"
  # Two-pass method for better quality (generates optimized palette)
  ffmpeg -i "$INPUT" -vf "fps=15,scale=640:-1:flags=lanczos,palettegen" -y /tmp/palette.png
  ffmpeg -i "$INPUT" -i /tmp/palette.png -lavfi "fps=15,scale=640:-1:flags=lanczos [x]; [x][1:v] paletteuse" -y "$OUTPUT"
}

function twin() {
  ~/.config/tmux/open-project.zsh "$@"
}

function claude() {
  trap '~/.config/tmux/mark-win.zsh ' INT
  command claude "$@"
  trap - INT
}

function repull() {
  local target=$1
  if [[ -z $target ]]; then
    echo "Usage: repull <branch>" >&2
    return 1
  fi

  git fetch origin "$target" || return 1

  if [[ $(git branch --show-current) == $target ]]; then
    # can't delete branch if on it; the first commit always exists and is never $target
    git checkout "$(git rev-list --max-parents=0 HEAD | tail -1)"
  fi

  git branch -D "$target"
  git checkout --track "origin/$target"
}

_repull() {
  local branches
  branches=(${(f)"$(git branch -a --format='%(refname:short)' 2>/dev/null | sed 's#^origin/##' | sort -u)"})
  compadd -a branches
}
compdef _repull repull
